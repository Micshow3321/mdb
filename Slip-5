Q.1 Write a Java Program to implement command pattern to test Remote Control.


a)Command.java
public interface Command {
 void execute();
}
b)Light.java
public class Light {
 String location;
 public Light(String location) {
 this.location = location;
}
 public void on() {
 System.out.println(location + " light is ON");
 }
 public void off() {
 System.out.println(location + " light is OFF");
 }
}
c)LightOnCommand.java
public class LightOnCommand implements Command {
 Light light;
 public LightOnCommand(Light light) {
 this.light = light;
 }
 public void execute() {
 light.on();
 }
}
d)LightOffCommand.java
public class LightOffCommand implements Command {
 Light light;
 public LightOffCommand(Light light) {
 this.light = light;
 }
 public void execute() {
 light.off();
 }
}
e)RemoteControl.java
public class RemoteControl {
 Command slot;
 public void setCommand(Command command) {
 slot = command;
 }
 public void buttonWasPressed() {
 if (slot != null) {
slot.execute();
 } else {
 System.out.println("No command assigned.");
 }
 }
}
f)RemoteControlTest.java(Run this file)
public class RemoteControlTest {
 public static void main(String[] args) {
 RemoteControl remote = new RemoteControl();
 Light livingRoomLight = new Light("Living Room");
 LightOnCommand lightOn = new LightOnCommand(livingRoomLight);
 LightOffCommand lightOff = new LightOffCommand(livingRoomLight);
 remote.setCommand(lightOn);
 remote.buttonWasPressed();
 remote.setCommand(lightOff);
remote.buttonWasPressed();
 }
}

Q.2 Write a program to get temperature notification using Arduino.

#define ADC_VREF_MV 5000.0 // Reference voltage in millivolts
#define ADC_RESOLUTION 1024.0 // ADC resoluƟon for 10-bit ADC
#define PIN_LM35 A0 // Pin where LM35 sensor is connected
void setup() {
 Serial.begin(9600);
} 
void loop() {
 // Read the ADC value from the LM35 temperature sensor
 int adc_val = analogRead(PIN_LM35);
 // Convert the ADC value to voltage in millivolts
 float millivolt = (adc_val * ADC_VREF_MV) / ADC_RESOLUTION;
 // Convert the voltage to temperature in Celsius (LM35 gives 10mV
per °C)
 float temp_c = millivolt / 10;
 // Convert Celsius to Fahrenheit
 float temp_f = (temp_c * 9.0 / 5.0) + 32.0;
 // Print temperature in the Serial Monitor
 Serial.print("Temperature: ");
Serial.print(temp_c);
 Serial.print("°C ");
 Serial.print(temp_f);
 Serial.println("°F");
 delay(1000); // Delay for 1 second
}
