f)RemoteControl.java
public class RemoteControl {
 Command slot;
 Command undoCommand;
 public void setCommand(Command command) {
 slot = command;
 }
 public void buttonWasPressed() {
 if (slot != null) {
 slot.execute();
 undoCommand = slot;
 }
}
 public void undoButtonWasPressed() {
 if (undoCommand != null) {
 undoCommand.undo();
 }
 }
}
