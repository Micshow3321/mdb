System.out.println("Ordering a New York style pizza:");
 Pizza nyPizza = nyStore.orderPizza();
 System.out.println("Ordered a " + nyPizza.getName() + "\n");
 System.out.println("Ordering a Chicago style pizza:");
 Pizza chicagoPizza = chicagoStore.orderPizza();
